# Copy to deploy/.env on the server (or services/core/.env for local dev) and fill in.

# ── Twitch ──────────────────────────────────────────────
# Register an app at https://dev.twitch.tv/console/apps
# (OAuth redirect URL can be http://localhost — it isn't used; category: Website Integration)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=elkz

# ── Logged & Loaded (Game Tracker) ─────────────────────
# Shows your public "Stream games" list. To show a different public list, change lists= to its link name.
# Set it empty to turn the Game Tracker feed off.
# BACKLOGGED_FEED_URL=https://backlogged.notelkz.net/api/public/elkz/games?lists=stream-games&count=30

# ── Last.fm (now playing in the header) ────────────────
# Get a key at https://www.last.fm/api/account/create (any name; callback URL can be left empty)
LASTFM_API_KEY=
LASTFM_USER=notelkz

# ── Discord ─────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications → Bot → Reset Token.
# Invite it with permissions: View Channels, Send Messages, Send Messages in Threads,
# Embed Links, Create Events, Manage Events.
DISCORD_BOT_TOKEN=
# Right-click your server → Copy Server ID (turn on Developer Mode in Discord settings first)
DISCORD_GUILD_ID=
# Channel or thread where new clips are posted (right-click → Copy Channel ID / Copy Thread ID)
DISCORD_CLIPS_CHANNEL_ID=

# Features (true/false)
DISCORD_SYNC_EVENTS=true
DISCORD_POST_CLIPS=true
DISCORD_TRACK_LIVE=true
DISCORD_EVENT_WINDOW_DAYS=14
DISCORD_BACKFILL_CLIPS=false

# ── Polling (seconds) ───────────────────────────────────
POLL_STREAM_SECONDS=60
POLL_SCHEDULE_SECONDS=600
POLL_CLIPS_SECONDS=600
POLL_VIDEOS_SECONDS=1800
